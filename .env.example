# ---- Datos ----
# Carpeta para todo lo que NO es código: data.db, CSV de Material Manager,
# purchase_order_po*.csv y adjuntos (fotos/facturas).
# En Render/Railway apúntala a un disco persistente montado, p. ej. /var/data
DATA_DIR=./data

# ---- Login (obligatorio en producción) ----
# Formato: correo:Nombre:hash  (separa usuarios con coma)
# Genera cada hash con:  npm run hash-password -- 'contraseña-larga'
# Ojo: en una shell usa comillas simples, el hash contiene "$".
AUTH_USERS=
# Mínimo 32 caracteres aleatorios:  openssl rand -hex 32
SESSION_SECRET=
# Solo desarrollo local: AUTH_DISABLED=1 salta el login (se ignora en producción).
# AUTH_DISABLED=1
# Solo para probar un build de producción en http://localhost:
# COOKIE_SECURE=0

# ---- Shopify (solo lectura) ----
SHOPIFY_SHOP_DOMAIN=
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
